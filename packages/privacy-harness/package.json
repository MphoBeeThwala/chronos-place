{
  "name": "@chronos/privacy-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy leak harness: plants synthetic markers and fails if they reach logs, events, errors, traces, URLs or notifications.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:privacy": "pnpm build && vitest run --config vitest.privacy.config.ts"
  },
  "dependencies": {
    "@chronos/logger": "workspace:*",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  },
  "devDependencies": {
    "@chronos/config": "workspace:*",
    "@chronos/contracts": "workspace:*",
    "@chronos/crypto": "workspace:*",
    "@chronos/service-kit": "workspace:*",
    "@chronos/tsconfig": "workspace:*",
    "@grpc/grpc-js": "^1.14.5",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/microservices": "^12.1.2",
    "@opentelemetry/api": "^1.9.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "vitest": "*"
  }
}
