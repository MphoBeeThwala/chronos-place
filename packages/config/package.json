{
  "name": "@chronos/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed, fail-fast environment configuration. The only place service code may read process.env.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chronos/tsconfig": "workspace:*"
  }
}
