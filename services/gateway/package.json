{
  "name": "@chronos/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && pnpm start",
    "start": "node --import @chronos/service-kit/instrument dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:privacy": "vitest run --config vitest.privacy.config.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/fastify": "^3.1.0",
    "@chronos/config": "workspace:*",
    "@chronos/contracts": "workspace:*",
    "@chronos/logger": "workspace:*",
    "@chronos/service-kit": "workspace:*",
    "@chronos/session-tokens": "workspace:*",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/apollo": "^14.2.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/graphql": "^14.2.1",
    "@nestjs/microservices": "^12.1.2",
    "graphql": "^16.14.2",
    "graphql-query-complexity": "^2.0.0",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chronos/privacy-harness": "workspace:*",
    "@chronos/tsconfig": "workspace:*",
    "@testcontainers/redis": "^12.2.2"
  }
}
