{
  "name": "@chronos/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && pnpm start",
    "start": "node --import @chronos/service-kit/instrument dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:privacy": "vitest run --config vitest.privacy.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1145.0",
    "@chronos/config": "workspace:*",
    "@chronos/contracts": "workspace:*",
    "@chronos/crypto": "workspace:*",
    "@chronos/logger": "workspace:*",
    "@chronos/service-kit": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/microservices": "^12.1.2",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chronos/privacy-harness": "workspace:*",
    "@chronos/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^12.2.2",
    "@testcontainers/redis": "^12.2.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.0"
  }
}
