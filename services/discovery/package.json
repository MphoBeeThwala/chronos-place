{
  "name": "@chronos/discovery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && pnpm start",
    "start": "node --import @chronos/service-kit/instrument dist/main.js",
