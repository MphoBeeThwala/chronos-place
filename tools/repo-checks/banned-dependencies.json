{
  "$comment": "CLAUDE.md rule 7: no third-party SDK that phones home (analytics, ads, attribution, session replay, vendor crash reporting) without an approved ADR. A pattern ending in /* matches a whole scope; 'name*' matches a prefix. To allow a package, add it to 'allowed' with the ADR that approves it.",
  "banned": [
    { "pattern": "firebase", "reason": "Firebase web SDK bundles Google Analytics" },
    { "pattern": "@firebase/analytics", "reason": "Google Analytics" },
    { "pattern": "@react-native-firebase/analytics", "reason": "Google Analytics" },
    { "pattern": "@react-native-firebase/crashlytics", "reason": "vendor crash reporting" },
    { "pattern": "expo-firebase-analytics", "reason": "Google Analytics" },
    { "pattern": "react-ga", "reason": "Google Analytics" },
    { "pattern": "react-ga4", "reason": "Google Analytics" },
    { "pattern": "ga-gtag", "reason": "Google Analytics" },
    { "pattern": "@next/third-parties", "reason": "Google Analytics and Tag Manager" },
    { "pattern": "react-gtm-module", "reason": "Google Tag Manager" },
    { "pattern": "react-native-google-mobile-ads", "reason": "advertising SDK" },
    { "pattern": "expo-ads-admob", "reason": "advertising SDK" },
    { "pattern": "react-native-admob", "reason": "advertising SDK" },
    { "pattern": "@segment/*", "reason": "Segment analytics" },
    { "pattern": "analytics-node", "reason": "Segment analytics" },
    { "pattern": "analytics-react-native", "reason": "Segment analytics" },
    { "pattern": "mixpanel*", "reason": "Mixpanel analytics" },
    { "pattern": "@amplitude/*", "reason": "Amplitude analytics" },
    { "pattern": "amplitude-js", "reason": "Amplitude analytics" },
    { "pattern": "react-native-appsflyer", "reason": "attribution SDK" },
    { "pattern": "react-native-adjust", "reason": "attribution SDK" },
    { "pattern": "@adjustcom/*", "reason": "attribution SDK" },
    { "pattern": "react-native-branch", "reason": "attribution SDK" },
    { "pattern": "react-native-fbsdk*", "reason": "Facebook SDK" },
    { "pattern": "expo-facebook", "reason": "Facebook SDK" },
    { "pattern": "react-facebook-pixel", "reason": "Facebook pixel" },
    { "pattern": "logrocket*", "reason": "session replay" },
    { "pattern": "@fullstory/*", "reason": "session replay" },
    { "pattern": "hotjar*", "reason": "session replay" },
    { "pattern": "@hotjar/*", "reason": "session replay" },
    { "pattern": "smartlook*", "reason": "session replay" },
    { "pattern": "@sentry/replay", "reason": "session replay (ADR-0005: no session replay)" },
    { "pattern": "@datadog/*", "reason": "vendor monitoring and session replay" },
    { "pattern": "dd-trace", "reason": "vendor APM" },
    { "pattern": "newrelic", "reason": "vendor APM" },
    { "pattern": "@newrelic/*", "reason": "vendor APM" },
    {
      "pattern": "@bugsnag/*",
      "reason": "vendor crash reporting (ADR-0005: self-hosted Sentry only)"
    },
    { "pattern": "@microsoft/applicationinsights-*", "reason": "vendor telemetry" },
    { "pattern": "react-native-appcenter*", "reason": "vendor telemetry" },
    { "pattern": "microsoft-clarity", "reason": "session replay" },
    { "pattern": "react-native-onesignal", "reason": "third-party push and engagement SDK" },
    { "pattern": "onesignal-*", "reason": "third-party push and engagement SDK" },
    { "pattern": "@braze/*", "reason": "third-party engagement SDK" },
    { "pattern": "react-native-braze", "reason": "third-party engagement SDK" },
    { "pattern": "@intercom/*", "reason": "third-party support SDK" },
    { "pattern": "intercom-client", "reason": "third-party support SDK" }
  ],
  "allowed": [
    { "pattern": "posthog-js", "adr": "ADR-0005", "note": "self-hosted PostHog only" },
    { "pattern": "posthog-node", "adr": "ADR-0005", "note": "self-hosted PostHog only" },
    { "pattern": "posthog-react-native", "adr": "ADR-0005", "note": "self-hosted PostHog only" },
    { "pattern": "@sentry/node", "adr": "ADR-0005", "note": "self-hosted Sentry only, no replay" },
    {
      "pattern": "@sentry/react-native",
      "adr": "ADR-0005",
      "note": "self-hosted Sentry only, no replay"
    },
    { "pattern": "@sentry/nextjs", "adr": "ADR-0005", "note": "self-hosted Sentry only, no replay" }
  ]
}
