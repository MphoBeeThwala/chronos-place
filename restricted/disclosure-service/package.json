{
  "name": "@chronos/disclosure-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && pnpm start",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:privacy": "vitest run --config vitest.privacy.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1145.0",
    "@chronos/config": "workspace:*",
    "@chronos/contracts": "workspace:*",
    "@chronos/crypto": "workspace:*",
    "@chronos/logger": "workspace:*",
    "@chronos/service-kit": "workspace:*",
    "@chronos/vault-db": "workspace:*",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/microservices": "^12.1.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chronos/privacy-harness": "workspace:*",
    "@chronos/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/pg": "^8.23.1"
  }
}
