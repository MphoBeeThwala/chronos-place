# apps/web/.env.example
# Copy to .env.local (git-ignored) for local development.

NODE_ENV=development
SERVICE_NAME=web
LOG_LEVEL=info

# GraphQL gateway. Server-side only: the browser reaches it through the same-origin /api/graphql
# rewrite, so no gateway URL is ever put into the browser bundle.
GATEWAY_URL=http://localhost:4000/graphql

# Photo storage (ADR-0024): the browser uploads to signed links here and loads photos from it,
# so it is added to the CSP's connect-src and img-src at build time. Development defaults to
# local SeaweedFS; production builds must set it (https), or photo uploads are blocked.
STORAGE_ORIGIN=http://127.0.0.1:8333
