# apps/web/.env.example
# Copy to .env.local (git-ignored) for local development.

NODE_ENV=development
SERVICE_NAME=web
LOG_LEVEL=info

# GraphQL gateway. Server-side only: the browser reaches it through the same-origin /api/graphql
# rewrite, so no gateway URL is ever put into the browser bundle.
GATEWAY_URL=http://localhost:4000/graphql
