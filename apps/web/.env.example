# apps/web/.env.example
# Copy to .env.local (git-ignored) for local development.

NODE_ENV=development
SERVICE_NAME=web
LOG_LEVEL=info
AWS_REGION=af-south-1

# GraphQL gateway (server-side)
GATEWAY_URL=http://localhost:4000/graphql

# Public env vars (exposed to the browser bundle)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_CDN=http://localhost:8333
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000/graphql
