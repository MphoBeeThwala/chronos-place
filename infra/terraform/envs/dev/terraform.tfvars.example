# infra/terraform/envs/dev/terraform.tfvars.example
#
# Copy this file to terraform.tfvars (git-ignored) and fill in real values.
# Never commit real account IDs or role ARNs to the repository.

# Your AWS account ID (dev account)
core_account_id = "123456789012"

# IAM ARNs that can manage KMS keys (platform/security team roles)
key_admin_arns = [
  "arn:aws:iam::123456789012:role/PlatformAdmin",
]

# Restrict EKS API access to your team's office/VPN IPs
allowed_cidr_blocks = [
  "203.0.113.0/24", # office
]

# GitHub Actions OIDC role ARN (created separately in shared-services account)
ci_role_arns = [
  "arn:aws:iam::123456789012:role/chronos-ci-github-actions",
]

# Populated after M2.2 when the disclosure-service IRSA role is created
disclosure_service_role_arns = []
